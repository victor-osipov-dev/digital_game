extends Control

# Подписчик-бейдж свежей фишки: белый кружок + зелёная галочка штрихами.
#
# Отдельный контрол в слое бейджей, а не _draw фишки, поэтому:
# - рисуется ПОВЕРХ соседних рядов (кружок не обрезается рядом);
# - не наследует прозрачность фишки (черновик 0.72, полёт) — галочка
#   всегда непрозрачная;
# - следует за фишкой каждый кадр: полёт, скролл, пересборка.
# Слой расположен ниже модалок, подсказок и меню, поэтому бейджи не нужно
# вручную гасить при каждом всплывающем окне.
# Тапы не перехватывает: висит над чужими фишками.
#
# Без class_name специально (кэш редактора): грузят через preload.
# Рисуем кодом, а не глифом: галочки нет во встроенном шрифте Web-сборки.

var check_color := Color("2E9E5B")


func _ready() -> void:
	mouse_filter = Control.MOUSE_FILTER_IGNORE


func _draw() -> void:
	var r := size.x * 0.5
	draw_circle(Vector2(r, r), r, Color(1, 1, 1, 0.96))
	var p1 := Vector2(r - 0.42 * r, r + 0.04 * r)
	var p2 := Vector2(r - 0.08 * r, r + 0.32 * r)
	var p3 := Vector2(r + 0.46 * r, r - 0.30 * r)
	draw_polyline(PackedVector2Array([p1, p2, p3]), check_color,
		maxf(2.5, r * 0.26), true)
