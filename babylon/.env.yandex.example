# Скопируйте в .env.local и заполните.
# App ID черновика игры из консоли Яндекс Игр.
# Без него официальный proxy умеет только dev-mode без настоящей рекламы.
YANDEX_APP_ID=

# Порт официального sdk-dev-proxy (по умолчанию 8080).
YANDEX_PROXY_PORT=8080

# Порт HTTP-моста для dev-mode (по умолчанию 8081).
YANDEX_BRIDGE_PORT=8081

# 1 — включить dev-mode, 0 — настоящая площадка (нужен YANDEX_APP_ID).
YANDEX_DEV_MODE=0
