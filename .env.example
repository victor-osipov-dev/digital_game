# ==============================================================
#  Образец файла настроек. Скопируй в .env и заполни.
#  Сам .env в git НЕ попадает (.gitignore), поэтому его можно
#  держать с живыми паролями.
# ==============================================================

# --- Учётные данные для деплоя по SSH ----------------------------
RU_HOST=<ip-сервера-в-россии>
RU_USER=root
RU_PASSWORD=<пароль>
RU2_HOST=<ip-второго-сервера>
RU2_USER=root
RU2_PASSWORD=<пароль>

# --- Общий секрет кластера --------------------------------------
# Один на все серверы. Им подписывается gossip (репликация аккаунтов
# и реестра серверов) и подписываются токены сессий. Секрет разный
# у клиента и сервера означает, что клиент не сможет подделать ни
# вход, ни ход. Длина — не меньше 32 случайных байт:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DG_CLUSTER_SECRET=<замени-на-32-случайных-байта>

# --- Порт игрового сервера --------------------------------------
# Один и тот же на обоих серверах: HTTP + WebSocket + TLS.
DG_PORT=6767

# --- Россия (Москва) ---------------------------------------------
DG_RU_SERVER_ID=srv-ru
DG_RU_SERVER_NAME=Россия
DG_RU_REGION=ru
DG_RU_PUBLIC_HOST=<ip-сервера-в-россии>

# --- Второй сервер -----------------------------------------------
# Код в имени ключа (RU2) произвольный: deploy.py и deploy_check.js
# находят цели сами по паре <КОД>_HOST / DG_<КОД>_*.
DG_RU2_SERVER_ID=srv-ru2
DG_RU2_SERVER_NAME=Россия 2
DG_RU2_REGION=ru
DG_RU2_PUBLIC_HOST=<ip-второго-сервера>

# --- Прочее -------------------------------------------------------
DG_CLIENT_PORT=6767
