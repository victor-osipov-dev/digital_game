# ==============================================================
#  Образец server.env — того, что кладётся в /etc/digital-game/
#  на САМОМ сервере. Права 0640, владелец digital-game:root.
#
#  На каждом сервере файл свой: адреса соседей и публичный адрес
#  у RU и LV различаются. Общее у них только DG_CLUSTER_SECRET —
#  он и делает их одним кластером.
#
#  Этот файл НЕ хранится в git. Образец лежит рядом.
# ==============================================================

# --- Кто я -------------------------------------------------------
DG_SERVER_ID=srv-ru
DG_SERVER_NAME=Россия
DG_REGION=ru

# Адрес, который видит клиент. Не обязательно тот, на который
# сервер слушает: за NAT/прокси может быть другое имя.
DG_PUBLIC_HOST=85.209.2.116
DG_PUBLIC_PORT=6767

DG_LISTEN_HOST=0.0.0.0
DG_LISTEN_PORT=6767

# --- TLS ---------------------------------------------------------
# Самоподписанный сертификат: домена нет, адрес — голый IP.
# Клиент зашивает этот сертификат и сверяет его побайтово.
DG_TLS_CERT=/etc/digital-game/tls/cert.pem
DG_TLS_KEY=/etc/digital-game/tls/key.pem
# Публичный сертификат для DNS-имён Web-клиентов (SNI). Нет файлов —
# работает только legacy-режим, Web-клиенты не подключатся.
#DG_TLS_LE_CERT=/etc/digital-game/tls/le-cert.pem
#DG_TLS_LE_KEY=/etc/digital-game/tls/le-key.pem

# --- Кластер -----------------------------------------------------
# Секрет ОДИН на все серверы. Им подписывается gossip и подписываются
# токены сессий: из-за этого аккаунт, заведённый на RU, работает на LV,
# а токен, выданный RU, принимает LV. Секрет разный у клиента и
# сервера — значит, клиент не может подделать ни вход, ни ход.
DG_CLUSTER_SECRET=ЗАМЕНИТЬ-НА-32-СЛУЧАЙНЫХ-БАЙТА

# Сосед, с которым обмениваемся раз в минуту. HTTPS с самоподписанным
# сертификатом, а подлинность всё равно проверяется подписью gossip.
DG_PEER_URLS=https://31.56.196.114:6767

# X-Forwarded-For учитываем только от этих прокси. По умолчанию заголовку
# не доверяем и для лимитов/журнала берём прямой адрес сокета.
# DG_TRUSTED_PROXIES=10.0.0.5
# DG_AUTH_IP_ATTEMPTS_PER_MIN=60
# Как часто объявляем себя соседям (требование: раз в минуту).
DG_GOSSIP_INTERVAL_MS=60000
# Сколько сервер может молчать, прежде чем его запись исчезнет из
# реестра. Должно быть заметно больше интервала, иначе живой
# сервер будет «мигать» в списке при просадке сети.
DG_SERVER_TTL_MS=180000

# --- Данные ------------------------------------------------------
DG_DATA_DIR=/var/lib/digital-game
# DG_DB_FILE=/var/lib/digital-game/digital-game.sqlite3

# --- Прочее -------------------------------------------------------
DG_LOG_LEVEL=info
# Сколько держать место игроку, который отвалился.
DG_DISCONNECT_GRACE_MS=90000
